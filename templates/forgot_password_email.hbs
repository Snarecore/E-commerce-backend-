<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Email Template</title>
	<style type="text/css">
		/* Internal CSS */

		@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap");

		body {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
			background-color: #ffffff;
			font-family: "Inter", sans-serif;
		}

		.customLogo {
			width: 100px;
			height: auto;
		}

		.customCheck {
			width: 50px;
			height: 50px;
		}
	</style>
</head>

<body>
	<table width="100%" cellspacing="0" cellpadding="0"
		style="margin: 0 auto; background-color: #ffffff; max-width: 881px">
		<tr>
			<td style="
            background-color: #49b098;
            padding: 40px 30px;
            border-radius: 10px 10px 0 0;
          ">
				<table width="100%" cellspacing="0" cellpadding="0">
					<tr>
						{{!-- <td>
							<a href=""><img class="logo customLogo"
									src="https://banglabriz.com/wp-content/uploads/2024/04/logo-full.png"
									alt="" /></a>
						</td> --}}
					</tr>
					<tr style="text-align: center">
						<td>
							<img class="customCheck"
								src="https://la-insurance.nyc3.cdn.digitaloceanspaces.com/email-template/checked-png.png"
								alt="" />
						</td>
						<td></td>
					</tr>

					<tr style="text-align: center">
						<td>
							<h1 style="
                    color: #ffffff;
                    padding: 5px 0 0 0;
                    margin: 0;
                    font-size: 36px;
                    font-weight: 600;
                    line-height: 40px;
                    font-family: 'Inter', sans-serif;
                  ">
								Bazaarbound Password Reset Request
							</h1>
						</td>
					</tr>
				</table>
			</td>
		</tr>
		<tr>
			<td style="
            background-color: #fff;
            padding-left: 5%;
            padding-right: 5%;
            padding-top: 40px;
          ">
				<table width="100%" cellspacing="0" cellpadding="0">
					<tr>
						<td>
							<p style="
                    font-size: 16px;
                    font-weight: 600;
                    line-height: 24px;
                    color: #1f2937;
                    font-family: 'Inter', sans-serif;
                  ">
								Hi {{username}},
							</p>
						</td>
					</tr>
					<tr>
						<td>
							<p style="
                    font-size: 16px;
                    font-weight: 400;
                    line-height: 24px;
                    color: #6b7280;
                    font-family: 'Inter', sans-serif;
                  ">
								We hope this email finds you well. We would like to inform you
								that, we got a request from you to reset your password.
							</p>
						</td>
					</tr>
					<tr>
						<td>
							<a href="{{passwordResetURL}}?token={{token}}&email={{email}}">
								<button style="
                    font-size: 16px;
                    font-weight: 600;
                    color: white;
                    background-color: #49b098;
                    padding: 14px 24px;
                    border-radius: 8px;
                    border: none;
                    margin: 10px 0px;
                    cursor: pointer;
                  ">
									Click to Reset Password
								</button>
							</a>
						</td>
					</tr>
					<tr>
						<td>
							<p style="
                    font-size: 16px;
                    font-weight: 400;
                    line-height: 24px;
                    color: #6b7280;
                    font-family: 'Inter', sans-serif;
                  ">
								Thanks for staying with us!
							</p>
						</td>
					</tr>

					<tr>
						<td>
							<p style="
                    padding: 0;
                    margin: 15px 0 0 0;
                    font-size: 16px;
                    font-weight: 600;
                    line-height: 24px;
                    color: #6b7280;
                    font-family: 'Inter', sans-serif;
                  ">
								Best regards
							</p>
							<p style="
                    padding: 0;
                    margin-top: 5px;
                    margin-bottom: 40px;
                    font-size: 16px;
                    font-weight: 600;
                    line-height: 24px;
                    color: #1f2937;
                    font-family: 'Inter', sans-serif;
                  ">
								Bazaarbound
							</p>
						</td>
					</tr>
				</table>
			</td>
		</tr>
		<tr>
			<td>
				<div style="
              border-width: 1px;
              border-color: #e5e7eb;
              border-style: solid;
            "></div>
			</td>
		</tr>
		<tr>
			<td style="
            text-align: center;
            font-size: 16px;
            color: #6b7280;
            padding-bottom: 100px;
          ">
				<table cellspacing="0" cellpadding="0"
					style="margin: auto; width: 100%; max-width: 600px; color: #6b7280">
					<tr>
						<td>
							<p style="font-size: 16px; font-weight: 400; color: #6b7280">
								If you have any questions, feel free to message us at
								<a href="mailto:`{{companyEmail}}`" style="
                      color: #1f2937;
                      font-weight: 700;
                      text-decoration: none;
                    ">{{companyEmail}}</a>. All rights reserved. Update email preferences or
								unsubscribe.
							</p>
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
</body>

</html>