<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Confirmation #{{orderId}} - Fashion Time</title>
  <style type="text/css">
    body {
      margin: 0;
      padding: 0;
      background-color: #f1f5f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #1e293b;
      -webkit-font-smoothing: antialiased;
    }
    table {
      border-collapse: collapse;
    }
    a {
      text-decoration: none;
    }
    @media only screen and (max-width: 620px) {
      .container {
        width: 100% !important;
        border-radius: 0 !important;
      }
      .content-padding {
        padding: 16px 14px !important;
      }
      .col-stack {
        display: block !important;
        width: 100% !important;
        box-sizing: border-box !important;
      }
    }
  </style>
</head>
<body style="margin: 0; padding: 16px 0; background-color: #f1f5f9;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #f1f5f9;">
    <tr>
      <td align="center">
        <!-- Main Email Container (Compact 560px width) -->
        <table role="presentation" class="container" width="560" cellspacing="0" cellpadding="0" style="max-width: 560px; width: 100%; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04); border: 1px solid #e2e8f0; margin: 0 auto;">
          
          <!-- Header Banner (Clean & Well-proportioned) -->
          <tr>
            <td style="background: linear-gradient(135deg, #218DAE 0%, #17657d 100%); padding: 18px 20px; text-align: center; color: #ffffff;">
              <h1 style="margin: 0; font-size: 20px; font-weight: 800; letter-spacing: -0.3px; color: #ffffff;">
                Fashion Time
              </h1>
              <p style="margin: 3px 0 0 0; font-size: 11px; color: #e0f2fe; letter-spacing: 0.8px; text-transform: uppercase; font-weight: 600;">
                Order Confirmation
              </p>
            </td>
          </tr>

          <!-- Confirmation Ribbon (Compact & Elegant) -->
          <tr>
            <td style="background-color: #ecfdf5; border-bottom: 1px solid #a7f3d0; padding: 8px 16px; text-align: center;">
              <span style="color: #065f46; font-size: 12px; font-weight: 600; line-height: 16px; display: inline-block;">
                ✓ Thank you for your order! We have received your order and are preparing it.
              </span>
            </td>
          </tr>

          <!-- Body Content -->
          <tr>
            <td class="content-padding" style="padding: 20px 22px;">
              <!-- Greeting -->
              <p style="margin: 0 0 4px 0; font-size: 14px; color: #0f172a; font-weight: 700;">
                Hi {{customerName}},
              </p>
              <p style="margin: 0 0 16px 0; font-size: 12px; line-height: 18px; color: #475569;">
                Great news! Your order <strong style="color: #218DAE;">#{{orderId}}</strong> has been successfully placed. You can track your order status and shipping progress anytime from your account dashboard.
              </p>

              <!-- Order Meta Card -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 16px;">
                <tr>
                  <td style="padding: 12px 14px;">
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                      <tr>
                        <td width="50%" valign="top" style="padding-bottom: 8px;">
                          <span style="font-size: 10px; text-transform: uppercase; color: #64748b; font-weight: 700; letter-spacing: 0.5px;">Order Number</span>
                          <div style="font-size: 13px; font-weight: 700; color: #0f172a; margin-top: 1px;">#{{orderId}}</div>
                        </td>
                        <td width="50%" valign="top" style="padding-bottom: 8px;">
                          <span style="font-size: 10px; text-transform: uppercase; color: #64748b; font-weight: 700; letter-spacing: 0.5px;">Order Date</span>
                          <div style="font-size: 13px; font-weight: 600; color: #0f172a; margin-top: 1px;">{{orderDate}}</div>
                        </td>
                      </tr>
                      <tr>
                        <td width="50%" valign="top" style="padding-top: 8px; border-top: 1px solid #e2e8f0;">
                          <span style="font-size: 10px; text-transform: uppercase; color: #64748b; font-weight: 700; letter-spacing: 0.5px;">Payment Method</span>
                          <div style="font-size: 13px; font-weight: 600; color: #0f172a; margin-top: 1px;">{{paymentMethod}}</div>
                        </td>
                        <td width="50%" valign="top" style="padding-top: 8px; border-top: 1px solid #e2e8f0;">
                          <span style="font-size: 10px; text-transform: uppercase; color: #64748b; font-weight: 700; letter-spacing: 0.5px;">Payment Status</span>
                          <div style="font-size: 13px; font-weight: 700; color: #059669; margin-top: 1px;">{{paymentStatus}}</div>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Order Items Section -->
              <div style="font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 8px;">
                Items in Your Order
              </div>
              
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; margin-bottom: 14px;">
                <thead>
                  <tr style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                    <th align="left" style="padding: 8px 12px; font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase;">Product</th>
                    <th align="center" style="padding: 8px 8px; font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase;">Qty</th>
                    <th align="right" style="padding: 8px 12px; font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase;">Total</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each items}}
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 10px 12px; vertical-align: middle;">
                      <div style="font-size: 13px; font-weight: 600; color: #0f172a;">{{this.name}}</div>
                      {{#if this.size}}
                      <div style="font-size: 11px; color: #64748b; margin-top: 1px;">Size: <span style="font-weight: 600; color: #334155;">{{this.size}}</span></div>
                      {{/if}}
                      <div style="font-size: 11px; color: #94a3b8; margin-top: 1px;">৳{{this.price}} each</div>
                    </td>
                    <td align="center" style="padding: 10px 8px; font-size: 13px; font-weight: 600; color: #334155; vertical-align: middle;">
                      ×{{this.quantity}}
                    </td>
                    <td align="right" style="padding: 10px 12px; font-size: 13px; font-weight: 700; color: #0f172a; vertical-align: middle;">
                      ৳{{this.total}}
                    </td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>

              <!-- Pricing Summary Calculation -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom: 16px;">
                <tr>
                  <td width="48%"></td>
                  <td width="52%">
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="font-size: 12px; color: #475569;">
                      <tr>
                        <td style="padding: 3px 0;">Subtotal:</td>
                        <td align="right" style="padding: 3px 0; font-weight: 600; color: #0f172a;">৳{{subtotal}}</td>
                      </tr>
                      <tr>
                        <td style="padding: 3px 0;">Delivery Charge:</td>
                        <td align="right" style="padding: 3px 0; font-weight: 600; color: #0f172a;">৳{{deliveryCharge}}</td>
                      </tr>
                      {{#if discountAmount}}
                      <tr>
                        <td style="padding: 3px 0; color: #059669;">Discount:</td>
                        <td align="right" style="padding: 3px 0; font-weight: 600; color: #059669;">-৳{{discountAmount}}</td>
                      </tr>
                      {{/if}}
                      <tr>
                        <td style="padding: 6px 0 2px 0; border-top: 1px solid #cbd5e1; font-size: 13px; font-weight: 700; color: #0f172a;">
                          Total Amount:
                        </td>
                        <td align="right" style="padding: 6px 0 2px 0; border-top: 1px solid #cbd5e1; font-size: 15px; font-weight: 800; color: #218DAE;">
                          ৳{{totalAmount}}
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Delivery Information Card -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 18px;">
                <tr>
                  <td style="padding: 12px 14px;">
                    <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px; margin-bottom: 4px;">
                      Shipping Address & Contact
                    </div>
                    <div style="font-size: 13px; font-weight: 700; color: #0f172a;">{{shippingName}}</div>
                    <div style="font-size: 12px; color: #475569; margin-top: 2px; line-height: 18px;">
                      {{shippingAddressText}}
                    </div>
                    <div style="font-size: 12px; color: #334155; margin-top: 2px; font-weight: 600;">
                      Phone: {{shippingPhone}}
                    </div>
                  </td>
                </tr>
              </table>

              <!-- CTA Button -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom: 14px;">
                <tr>
                  <td align="center">
                    <a href="{{viewOrderUrl}}" target="_blank" style="display: inline-block; background-color: #218DAE; color: #ffffff; font-size: 13px; font-weight: 700; padding: 10px 24px; border-radius: 8px; text-decoration: none; box-shadow: 0 2px 6px rgba(33, 141, 174, 0.25);">
                      View Order & Track Status →
                    </a>
                  </td>
                </tr>
              </table>

              <p style="margin: 0; font-size: 11px; color: #94a3b8; text-align: center; line-height: 16px;">
                You will receive another email notification with tracking information once your package is dispatched.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 16px 20px; text-align: center;">
              <p style="margin: 0 0 3px 0; font-size: 12px; font-weight: 600; color: #475569;">
                Need help with your order?
              </p>
              <p style="margin: 0 0 8px 0; font-size: 11px; color: #64748b;">
                Contact our customer support team at <a href="mailto:{{supportEmail}}" style="color: #218DAE; font-weight: 600;">{{supportEmail}}</a>
              </p>
              <p style="margin: 0; font-size: 10px; color: #94a3b8;">
                © {{currentYear}} Fashion Time. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
