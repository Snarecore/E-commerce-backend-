{
	"name": "bazaar-bound",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build && tsc-alias",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"start:cluster": "pm2 start ecosystem.config.js",
		"typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/configs/typeorm.config.ts",
		"migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/configs/typeorm.config.ts",
		"migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/configs/typeorm.config.ts",
		"migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/configs/typeorm.config.ts",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"seed:products": "NODE_PATH=./node_modules node scripts/seed-product-details.js",
		"prepare": "husky install"
	},
	"dependencies": {
		"@nestjs-modules/mailer": "^2.0.2",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.0",
		"@nestjs/core": "^11.0.1",
		"@nestjs/event-emitter": "^3.1.0",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/mapped-types": "*",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/platform-socket.io": "^11.2.3",
		"@nestjs/schedule": "^6.0.0",
		"@nestjs/throttler": "^6.5.0",
		"@nestjs/typeorm": "^11.0.0",
		"@nestjs/websockets": "^11.2.3",
		"aws4": "^1.13.2",
		"axios": "^1.21.1",
		"bcryptjs": "^3.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cloudinary": "^2.10.0",
		"compression": "^1.8.2",
		"cookie-parser": "^1.4.7",
		"dotenv": "^16.4.7",
		"express": "^5.3.0",
		"firebase-admin": "^13.6.0",
		"handlebars": "^4.7.10",
		"helmet": "^8.3.0",
		"mysql2": "^3.24.6",
		"nodemailer": "^7.0.13",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"socket.io": "^4.8.3",
		"stripe": "^18.1.0",
		"typeorm": "^0.3.31",
		"uuid": "^11.1.0",
		"xss": "^1.0.15",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.9",
		"@swc/cli": "^0.6.0",
		"@swc/core": "^1.10.7",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.8",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.7",
		"@types/passport": "^1.0.17",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^6.0.2",
		"@typescript-eslint/eslint-plugin": "^8.24.0",
		"@typescript-eslint/parser": "^8.24.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-prettier": "^5.2.3",
		"globals": "^15.14.0",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"lint-staged": "^15.4.3",
		"prettier": "^3.5.1",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node",
		"moduleNameMapper": {
			"^src/(.*)$": "<rootDir>/$1"
		}
	},
	"engines": {
		"node": "22.x"
	},
	"overrides": {
		"jwks-rsa": "^3.2.1",
		"jose": "^4.15.9"
	},
	"packageManager": "pnpm@10.4.1+sha256.4b702887986995933d4300836b04d6d02a43bc72b52e4f7e93a4ca608b959197",
	"pnpm": {
		"overrides": {
			"body-parser@^2": "^2.4.0",
			"brace-expansion@^1": "^1.1.22",
			"brace-expansion@^2": "^2.1.8",
			"fast-xml-parser@^4": "^4.5.7",
			"form-data@^4": "^4.0.6",
			"glob@^10": "^10.5.0",
			"js-cookie@^3": "^3.0.8",
			"jws@^3": "^3.2.3",
			"linkify-it@^5": "^5.0.2",
			"liquidjs@^10": "^10.30.1",
			"lodash@^4": "^4.18.1",
			"minimatch@^3": "^3.1.5",
			"minimatch@^5": "^5.1.9",
			"minimatch@^9": "^9.0.9",
			"nodemailer@^7": "^7.0.13",
			"path-to-regexp@^8": "^8.4.2",
			"picomatch@^2": "^2.3.2",
			"proxy-addr@^2": "^2.0.8",
			"qs@^6": "^6.17.1",
			"sha.js@^2": "^2.4.12",
			"validator@^13": "^13.15.35"
		}
	}
}
