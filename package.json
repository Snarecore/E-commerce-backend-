		"@nestjs/schedule": "^6.0.0",
		"@nestjs/throttler": "^6.5.0",
		"@nestjs/typeorm": "^11.0.0",
		"@types/body-parser": "^1.19.5",
		"aws-sdk": "^2.1692.0",
		"aws4": "^1.13.2",
		"axios": "^1.11.0",
		"bcryptjs": "^3.0.0",
		"body-parser": "^1.20.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cloudinary": "^2.10.0",
		"cookie-parser": "^1.4.7",
		"dotenv": "^16.4.7",
		"express": "^5.0.1",
		"handlebars": "^4.7.8",
		"jsonwebtoken": "^9.0.2",
