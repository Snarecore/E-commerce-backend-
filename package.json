		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.9",
		"@swc/cli": "^0.6.0",
		"@swc/core": "^1.10.7",
		"@types/bcrypt": "^5.0.2",
		"@types/cookie-parser": "^1.4.8",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
